-- ตัวแปรควบคุมระบบออโต้ซื้อเมล็ด
local isAutoBuyActive = false
local attemptedPrompts = {}

local function unequipTools()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:UnequipTools()
        end
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                item.Parent = player.Backpack
            end
        end
    end
end

AutoBuyBtn.MouseButton1Click:Connect(function()
    isAutoBuyActive = not isAutoBuyActive
    if isAutoBuyActive then
        AutoBuyBtn.Text = "เปิด"
        AutoBuyBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- สีเขียว
    else
        AutoBuyBtn.Text = "ปิด"
        AutoBuyBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- สีแดง
        table.clear(attemptedPrompts)
    end
end)

-- ลูปการทำงานซื้อเมล็ดอัตโนมัติเบื้องหลัง (ดีเลย์ 1.5 วินาที)
task.spawn(function()
    while task.wait(1.5) do
        if isAutoBuyActive then
            pcall(function()
                local currentActivePrompts = {}

                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if descendant:IsA("ProximityPrompt") then
                        local action = tostring(descendant.ActionText):lower()
                        local object = tostring(descendant.ObjectText):lower()
                        
                        local isBuy = action:find("ซื้อ") or object:find("ซื้อ") or action:find("buy")
                        local isSeed = object:find("เมล็ด") or object:find("seed") or action:find("เมล็ด") or action:find("seed")
                        
                        if isBuy and isSeed then
                            currentActivePrompts[descendant] = true
                            
                            if not attemptedPrompts[descendant] then
                                descendant.MaxActivationDistance = 999999
                                if fireproximityprompt then
                                    fireproximityprompt(descendant)
                                    attemptedPrompts[descendant] = true
                                    
                                    -- เก็บเมล็ดเข้ากระเป๋าอัตโนมัติทันที ไม่ให้ถือค้างในมือ
                                    task.delay(0.3, function()
                                        unequipTools()
                                    end)
                                end
                            end
                        end
                    end
                end
                
                -- เคลียร์ประวัติเมื่อปุ่มนั้นหายไป (ซื้อสำเร็จ หรือรีเซ็ต)
                for prompt, _ in pairs(attemptedPrompts) do
                    if not currentActivePrompts[prompt] or not prompt.Parent then
                        attemptedPrompts[prompt] = nil
                    end
                end
            end)
        end
    end
end)

