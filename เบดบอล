-- ==================== ระบบกดตีจริง 100% (VirtualUser Click) ====================

local lastHit = 0

-- ฟังก์ชันดึงลูกบอลจริงในเกม
local function GetBall()
	local balls = workspace:FindFirstChild("Balls")
	if balls then
		for _, b in pairs(balls:GetChildren()) do
			if b:IsA("BasePart") and b.Transparency < 0.9 then
				return b
			end
		end
	end
	return nil
end

-- ฟังก์ชันสั่งกดตีจริงผ่านระบบ VirtualUser ของ Roblox (ไม่โดนบล็อกแน่นอน)
local function PerformClick()
	if tick() - lastHit < 0.15 then return end
	lastHit = tick()
	
	pcall(function()
		VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
		task.wait(0.01)
		VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
	end)
end

-- ลูปเช็คความเร็วและระยะห่างของลูกบอล
table.insert(getgenv().GH1JK_BladeBall_Connections, RunService.PreRender:Connect(function()
	if not AutoParryEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local ball = GetBall()
	if not ball then return end

	-- เช็คว่าบอลเล็งมาที่ตัวเราจริงหรือไม่ (ดูจาก Target Attribute หรือ Highlight สีแดง)
	local targetVal = ball:GetAttribute("Target")
	local isTargetMe = (targetVal == LocalPlayer.Name)

	if not isTargetMe then
		local highlight = ball:FindFirstChildOfClass("Highlight")
		if highlight and (highlight.FillColor == Color3.fromRGB(255, 0, 0) or highlight.OutlineColor == Color3.fromRGB(255, 0, 0)) then
			isTargetMe = true
		end
	end

	local ballPos = ball.Position
	local ballVelocity = ball.AssemblyLinearVelocity or ball.Velocity
	local distance = (ballPos - hrp.Position).Magnitude
	local ballSpeed = ballVelocity.Magnitude

	if ballSpeed < 5 then ballSpeed = 5 end

	-- ระยะคำนวณการกดตีแบบเป๊ะๆ
	local ping = (LocalPlayer:GetNetworkPing() or 0.05)
	local parryDistance = (ballSpeed * 0.22) + (ping * 30)
	parryDistance = math.clamp(parryDistance, 15, 120)

	-- บอลเล็งมาและถึงระยะ -> สั่งตีทันที!
	if isTargetMe and distance <= parryDistance then
		PerformClick()
	end
end))
