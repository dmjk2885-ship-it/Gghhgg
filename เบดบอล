local lastParry = 0

-- ฟังก์ชันค้นหาลูกบอล
local function GetBall()
	local balls = workspace:FindFirstChild("Balls")
	if balls then
		for _, b in pairs(balls:GetChildren()) do
			if b:IsA("BasePart") and b.Transparency < 0.9 then
				return b
			end
		end
	end
	return nil
end

-- ฟังก์ชันกดตีบอลสำหรับ Delta
local function HitParry()
	if os.clock() - lastParry < 0.12 then return end
	lastParry = os.clock()

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
	end)
end

-- ลูปการทำงาน (ใช้ Heartbeat แบบป้องกัน Nil)
local conn = RunService.Heartbeat:Connect(function()
	if not AutoParryEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local ball = GetBall()
	if not ball then return end

	-- เช็คเป้าหมายลูกบอล
	local isTargetMe = false
	pcall(function()
		local targetName = ball:GetAttribute("Target")
		if targetName == LocalPlayer.Name then
			isTargetMe = true
		end
	end)

	if not isTargetMe then
		local highlight = ball:FindFirstChildOfClass("Highlight")
		if highlight and (highlight.FillColor == Color3.fromRGB(255, 0, 0) or highlight.OutlineColor == Color3.fromRGB(255, 0, 0)) then
			isTargetMe = true
		end
	end

	local ballPos = ball.Position
	local ballVel = ball.AssemblyLinearVelocity or ball.Velocity or Vector3.new()
	local dist = (ballPos - hrp.Position).Magnitude
	local speed = ballVel.Magnitude

	if speed < 5 then speed = 5 end

	local ping = 0.05
	pcall(function()
		ping = LocalPlayer:GetNetworkPing()
	end)

	local parryDistance = math.clamp((speed * 0.20) + (ping * 25), 15, 100)

	if isTargetMe and dist <= parryDistance then
		HitParry()
	end
end)

table.insert(genv.GH1JK_BladeBall_Connections, conn)
