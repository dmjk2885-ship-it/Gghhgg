-- ==================== ระบบคำนวณและตีบอลที่ปลอดภัย (Anti-Kick) ====================

local lastParryTime = 0
local parryCooldown = 0.25 -- ป้องกันการส่งคำสั่งถี่เกินไปที่จะทำให้โดนเตะ

-- ค้นหา Remote ของ Blade Ball
local function GetParryRemote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
	for _, v in pairs(remotes:GetDescendants()) do
		if v:IsA("RemoteEvent") and (v.Name == "ParryButtonPress" or v.Name == "Parry" or v.Name == "ParryAttempt" or string.find(string.lower(v.Name), "parry")) then
			return v
		end
	end
	return nil
end

-- ฟังก์ชันค้นหาลูกบอล
local function GetBall()
	local ballsFolder = workspace:FindFirstChild("Balls")
	if ballsFolder then
		for _, child in pairs(ballsFolder:GetChildren()) do
			if child:IsA("BasePart") or child.Name == "Ball" then
				return child
			end
		end
	end
	for _, obj in pairs(workspace:GetChildren()) do
		if (obj.Name == "Ball" or string.find(string.lower(obj.Name), "ball")) and obj:IsA("BasePart") then
			return obj
		end
	end
	return nil
end

-- ฟังก์ชันตีบอลอย่างปลอดภัย (Safe Parry)
local function SafeParry()
	local currentTime = tick()
	if currentTime - lastParryTime < parryCooldown then return end
	lastParryTime = currentTime

	-- วิธีที่ 1: ยิงผ่าน RemoteEvent ของเกมโดยตรง (เนียนที่สุด ปลอดภัยจากการโดนเตะ)
	local parryRemote = GetParryRemote()
	if parryRemote then
		pcall(function()
			parryRemote:FireServer(0.5, CFrame.new(), {}, {0, 0})
		end)
	else
		-- วิธีที่ 2: ใช้ KeyPress Event แบบปลอดภัยกรณีหา Remote ไม่เจอ
		pcall(function()
			keypress(0x46) -- กดปุ่ม F
			task.wait(0.02)
			keyrelease(0x46)
		end)
	end
end

-- ลูปการทำงาน
table.insert(getgenv().GH1JK_BladeBall_Connections, RunService.Heartbeat:Connect(function()
	if not AutoParryEnabled then return end
	
	local myChar = LocalPlayer.Character
	if not myChar then return end
	
	local hrp = myChar:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	local ball = GetBall()
	if not ball then return end

	-- ตรวจสอบว่าเป้าหมายลูกบอลคือตัวเราหรือไม่
	local targetPlayerName = ball:GetAttribute("Target") or (ball:FindFirstChild("Target") and ball.Target.Value)
	local isTargetingMe = (targetPlayerName == LocalPlayer.Name)

	local ballPos = ball.Position
	local ballVelocity = ball.AssemblyLinearVelocity or ball.Velocity
	local distance = (ballPos - hrp.Position).Magnitude
	local ballSpeed = ballVelocity.Magnitude

	if ballSpeed < 1 then ballSpeed = 1 end

	local timeToReach = distance / ballSpeed
	local ping = (LocalPlayer:GetNetworkPing() or 0.05)

	-- ระยะคำนวณที่ปลอดภัยจากการตรวจจับ
	local safeDistanceThreshold = math.clamp(ballSpeed * 0.1 + (ping * 10), 12, 50)

	if isTargetingMe and (distance <= safeDistanceThreshold or timeToReach <= (0.28 + ping)) then
		SafeParry()
	end
end))
