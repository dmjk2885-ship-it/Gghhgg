-- ==================== ระบบสแกนหาบอล และ Auto Parry แก้บัค ====================

local lastParry = 0

-- สแกนหาลูกบอลในทุกมุมของ Workspace
local function GetActiveBall()
	local balls = workspace:FindFirstChild("Balls")
	if balls then
		for _, b in pairs(balls:GetChildren()) do
			if b:IsA("BasePart") and b.Transparency < 0.9 and not b:GetAttribute("IsDead") then
				return b
			end
		end
	end
	for _, b in pairs(workspace:GetChildren()) do
		if b:IsA("BasePart") and (b.Name == "Ball" or string.find(string.lower(b.Name), "ball")) then
			return b
		end
	end
	return nil
end

-- ฟังก์ชันส่งคำสั่งตีบอล (ผสมผสานหลายวิธีเพื่อให้แน่ใจว่ายิงออกแน่นอน)
local function TriggerParry()
	if tick() - lastParry < 0.12 then return end
	lastParry = tick()

	-- วิธีที่ 1: เรียกใช้ RemoteEvent ของ Blade Ball แบบครอบจักรวาล
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
		for _, v in pairs(remotes:GetDescendants()) do
			if v:IsA("RemoteEvent") and (string.find(string.lower(v.Name), "parry") or string.find(string.lower(v.Name), "ability")) then
				v:FireServer(0.5, CFrame.new(), {}, {0, 0})
			end
		end
	end)

	-- วิธีที่ 2: จำลองการกดคลิก/แตะปุ่มกด Parry ของตัวเกมบนหน้าจอ
	pcall(function()
		local GuiService = game:GetService("GuiService")
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
		task.wait(0.01)
		vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
	end)
end

-- ลูปคำนวณและสั่งตีบอลเรียลไทม์
table.insert(getgenv().GH1JK_BladeBall_Connections, RunService.RenderStepped:Connect(function()
	if not AutoParryEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local ball = GetActiveBall()
	if not ball then return end

	-- เช็คว่าตัวเราคือเป้าหมายหรือไม่ (หรือกรณีบอลเปลี่ยนเป็นสีแดง)
	local targetName = ball:GetAttribute("Target") or (ball:FindFirstChild("Target") and ball.Target.Value)
	local dot = ball:FindFirstChild("Dot")
	local isTargetMe = (targetName == LocalPlayer.Name) or (dot and dot.Color == Color3.fromRGB(255, 0, 0))

	local ballPos = ball.Position
	local ballVel = ball.AssemblyLinearVelocity or ball.Velocity
	local dist = (ballPos - hrp.Position).Magnitude
	local speed = ballVel.Magnitude

	if speed < 5 then speed = 5 end

	-- ระยะปลอดภัยในการตีบอล
	local ping = (LocalPlayer:GetNetworkPing() or 0.05)
	local parryDistance = math.clamp((speed * 0.15) + (ping * 20), 15, 80)

	-- เมื่อบอลล็อคเป้ามาที่ตัวเราและอยู่ในระยะ ให้สั่งตีทันที
	if isTargetMe and dist <= parryDistance then
		TriggerParry()
	end
end))
